{
  "name": "bsv-wallet",
  "version": "0.1.0",
  "description": "Simple BSV wallet for OpenClaw agents. UTXO tracking, balance, send, receive.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bsv-wallet": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
