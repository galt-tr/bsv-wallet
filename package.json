  ],
  "keywords": ["bsv", "bitcoin", "wallet", "openclaw", "agent"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/galt-tr/bsv-wallet.git"
  },
  "dependencies": {
